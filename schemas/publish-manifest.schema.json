{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tare.tools Publication Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "document_id",
    "document_type",
    "status",
    "repository",
    "bounded_contexts",
    "artifacts",
    "canonical_change"
  ],
  "properties": {
    "packet_version": {"enum": ["1.0", "1.1"]},
    "document_id": {"type": "string"},
    "document_type": {
      "enum": ["research", "proposal", "experiment", "archaeology", "handoff", "source", "finding", "adr", "spec", "bdd", "implementation_packet"]
    },
    "status": {"enum": ["RESEARCH", "PROPOSED", "EXPERIMENTAL", "HISTORICAL", "TARGET", "CURRENT"]},
    "repository": {"enum": ["tare.tools.research", "tare-tools"]},
    "destination": {"type": ["string", "null"]},
    "bounded_contexts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "primary_artifact": {"type": "string"},
    "requested_channels": {"type": "array", "items": {"enum": ["pages"]}, "uniqueItems": true},
    "historical_preservation": {"type": "boolean"},
    "canonical_change": {"type": "boolean"},
    "promotion_packet": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
