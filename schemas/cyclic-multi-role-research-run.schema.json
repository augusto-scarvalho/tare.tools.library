{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CMRP Run Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "method",
    "executor",
    "status",
    "strict_proof_eligible",
    "role_artifacts",
    "final_decision"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "run_id": {
      "type": "string"
    },
    "method": {
      "const": "cyclic-multi-role-research-protocol"
    },
    "executor": {
      "type": "object",
      "required": [
        "model",
        "mode",
        "epistemic_independence"
      ]
    },
    "status": {
      "type": "string"
    },
    "strict_proof_eligible": {
      "type": "boolean"
    },
    "role_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256",
          "bytes"
        ]
      }
    },
    "final_decision": {
      "type": "string"
    }
  }
}
