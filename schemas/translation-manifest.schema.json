{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tare.tools/schemas/translation-manifest.schema.json",
  "title": "tare.tools Translation Manifest",
  "type": "object",
  "required": [
    "schema_version", "translation_id", "translation_of", "source_path",
    "source_sha256", "translation_path", "translation_sha256",
    "source_language", "target_language", "translation_status", "translator", "translated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "translation_id": {"type": "string", "minLength": 1},
    "translation_of": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "translation_path": {"type": "string", "minLength": 1},
    "translation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "translation_size_bytes": {"type": "integer", "minimum": 0},
    "source_language": {"const": "pt-BR"},
    "target_language": {"const": "en"},
    "translation_status": {"enum": ["MACHINE_TRANSLATED_UNREVIEWED", "HUMAN_REVIEWED", "SUPERSEDED"]},
    "translator": {"type": "string", "minLength": 1},
    "translated_at": {"type": "string", "minLength": 1},
    "policy": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
