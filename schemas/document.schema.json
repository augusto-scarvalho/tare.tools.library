{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tare.tools document metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "title",
    "document_type",
    "status",
    "created_at",
    "bounded_contexts",
    "provenance"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "enum": [
        "research",
        "proposal",
        "experiment",
        "archaeology",
        "handoff",
        "source",
        "finding",
        "adr",
        "spec",
        "bdd",
        "implementation_packet"
      ]
    },
    "status": {
      "enum": [
        "RESEARCH",
        "PROPOSED",
        "EXPERIMENTAL",
        "HISTORICAL",
        "TARGET",
        "CURRENT"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "abstract": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"enum": ["author", "editor", "contributor", "agent"]}
        },
        "additionalProperties": false
      }
    },
    "architecture_epoch": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "bounded_contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
