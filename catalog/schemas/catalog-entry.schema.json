{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tare.tools catalog entry",
  "type": "object",
  "required": [
    "document_id",
    "title",
    "path",
    "sha256",
    "size_bytes",
    "status",
    "document_type",
    "bounded_contexts"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "RESEARCH",
        "PROPOSED",
        "EXPERIMENTAL",
        "HISTORICAL",
        "TARGET",
        "CURRENT"
      ]
    },
    "document_type": {
      "enum": [
        "research",
        "proposal",
        "experiment",
        "archaeology",
        "handoff",
        "source",
        "finding",
        "adr",
        "spec",
        "bdd",
        "implementation_packet"
      ]
    },
    "bounded_contexts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    }
  }
}
