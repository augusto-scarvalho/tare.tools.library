{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchFrontierCluster",
  "type": "object",
  "required": [
    "id",
    "title",
    "pointer_ids",
    "authority"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "pointer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "const": "RESEARCH_ONLY_NO_IMPLEMENTATION_AUTHORITY"
    }
  },
  "additionalProperties": false
}
