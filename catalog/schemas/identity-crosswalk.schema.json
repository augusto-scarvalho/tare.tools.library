{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tare.tools/schemas/identity-crosswalk.schema.json",
  "title": "tare.tools File Library Materialization Crosswalk",
  "type": "object",
  "required": [
    "schema_version", "file_library_id", "reference_id", "reference_path",
    "materialization_status", "materialization_basis", "source_sha256",
    "source_path", "document_id", "translation_state", "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "file_library_id": {"type": "string", "pattern": "^file_[0-9a-f]+$"},
    "reference_id": {"type": "string"},
    "reference_path": {"type": "string"},
    "materialization_status": {"enum": ["MATERIALIZED_NEW", "ALREADY_MATERIALIZED_BY_HASH"]},
    "materialization_basis": {"enum": ["FILE_LIBRARY_EXACT_EXPORT", "USER_SUPPLIED_EXACT_EXPORT", "OTHER_EXACT_BYTE_SOURCE"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reported_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "reported_hash_verification": {"enum": ["MATCH", "NO_REPORTED_HASH"]},
    "source_path": {"type": "string"},
    "document_id": {"type": "string"},
    "source_language": {"type": "string"},
    "translation_state": {"enum": ["READY_FOR_TRANSLATION", "NOT_REQUIRED_NATIVE_ENGLISH", "TRANSLATION_ALREADY_PRESENT"]},
    "recorded_at": {"type": "string"}
  },
  "additionalProperties": false
}
