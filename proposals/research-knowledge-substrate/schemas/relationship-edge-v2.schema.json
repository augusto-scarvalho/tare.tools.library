{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROPOSED ResearchRelationshipEdgeV2",
  "type": "object",
  "required": [
    "edge_id",
    "from",
    "to",
    "relation",
    "basis",
    "status"
  ],
  "properties": {
    "edge_id": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "relation": {
      "type": "string"
    },
    "basis": {
      "enum": [
        "observed_citation",
        "observed_crosswalk",
        "document_structure",
        "curated",
        "inferred",
        "external_metadata"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "polarity": {
      "enum": [
        "supportive",
        "constraining",
        "challenging",
        "neutral"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "verified",
        "curated",
        "rejected",
        "superseded"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object"
    },
    "created_by": {
      "enum": [
        "human",
        "tool",
        "model"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
